# Copy to .env and fill in only when you want real AWS calls.
# With these left empty, FieldSight stores uploads on local disk and still
# returns s3://fieldsight-local/... URIs.

FIELDSIGHT_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional S3-compatible endpoint (MinIO, LocalStack). Leave empty for AWS.
AWS_ENDPOINT_URL=

# Optional. When set, clearance.write asks Bedrock to phrase the note.
# The CLEAR / HOLD / ESCALATE decision stays on the OpenCV policy either way.
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-east-1

# Optional Jev (TypeSafe System One) decision aid. Leave empty for the local
# heuristic. The aid does not see the photo. See README for keys and cost.
# JEV_API_KEY=
# TYPESAFE_API_KEY=
# JEV_DUAL_RUN=1
# JEV_PRIMARY=1
# JEV_MODEL=jev-1.13.0

# Used by the Lambda package, not by the local web demo.
FIELDSIGHT_TRADE=electrical

# Next.js rewrite target for /api/vision/*
FIELDSIGHT_API_ORIGIN=http://127.0.0.1:43124
